
@model List<WebApplication2.Models.CartItem>
@using System.Linq

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    decimal total = Model.Sum(x => x.SubTotal);
}

<h2>GIỎ HÀNG CỦA BẠN</h2>
<hr />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Giỏ hàng của bạn đang trống.
    </div>

    @Html.ActionLink(
            "Tiếp tục mua sắm",
            "ProductList",
            "Home",
            null,
            new { @class = "btn btn-primary" })
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>

                    <td>
                        @item.ProductPrice.ToString("N0") đ
                    </td>

                    <td>
                        @using (Html.BeginForm(
                            "Update", "Cart", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.ProductID" />

                            <input type="number"
                                   name="quantity"
                                   value="@item.Quantity"
                                   min="1"
                                   class="form-control"
                                   style="width:85px;display:inline-block;" />

                            <button type="submit"
                                    class="btn btn-info btn-sm">
                                Cập nhật
                            </button>
                        }
                    </td>

                    <td>
                        @item.SubTotal.ToString("N0") đ
                    </td>

                    <td>
                        @using (Html.BeginForm(
                            "Remove", "Cart", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.ProductID" />

                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Xóa
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3 class="text-right">
        Tổng tiền:
        <span style="color:#d9534f;">
            @total.ToString("N0") đ
        </span>
    </h3>

    <div class="text-right">
        @Html.ActionLink(
                 "Tiếp tục mua sắm",
                 "ProductList",
                 "Home",
                 null,
                 new { @class = "btn btn-default" })

        @Html.ActionLink(
                 "Tiến hành thanh toán",
                 "Checkout",
                 "Order",
                 null,
                 new { @class = "btn btn-success" })
    </div>
}
