
@model WebApplication2.Models.CustomerEditVM

@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h2>THÔNG TIN TÀI KHOẢN</h2>
<hr />

<div class="row">
    <div class="col-md-7">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @using (Html.BeginForm("Edit", "Account",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.CustomerID)

            @Html.ValidationSummary(
                     true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.Username)
                @Html.TextBoxFor(m => m.Username,
                         new { @class = "form-control", @readonly = "readonly" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.CustomerName)
                @Html.TextBoxFor(m => m.CustomerName,
                         new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerName,
                         "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.CustomerPhone)
                @Html.TextBoxFor(m => m.CustomerPhone,
                         new { @class = "form-control", maxlength = "15" })
                @Html.ValidationMessageFor(m => m.CustomerPhone,
                         "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.CustomerEmail)
                @Html.TextBoxFor(m => m.CustomerEmail,
                         new { @class = "form-control", type = "email" })
                @Html.ValidationMessageFor(m => m.CustomerEmail,
                         "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.CustomerAddress)
                @Html.TextAreaFor(m => m.CustomerAddress,
                         new { @class = "form-control", rows = "3" })
            </div>

            <button type="submit" class="btn btn-success">
                Lưu thay đổi
            </button>

            @Html.ActionLink(
                     "Quay về trang chủ",
                     "Index",
                     "Home",
                     null,
                     new { @class = "btn btn-default" })
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
