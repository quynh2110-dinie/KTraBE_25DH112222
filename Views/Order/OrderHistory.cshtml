
@model IEnumerable<WebApplication2.Models.Order>
@using System.Linq

@{
    ViewBag.Title = "Lịch sử mua hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h2>LỊCH SỬ MUA HÀNG</h2>
<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">
        Bạn chưa có đơn hàng nào.
    </div>

    @Html.ActionLink(
            "Mua sắm ngay",
            "ProductList",
            "Home",
            null,
            new { @class = "btn btn-primary" })
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Thanh toán</th>
                <th>Trạng thái</th>
                <th>Chi tiết</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>#@item.OrderID</td>

                    <td>@item.OrderDate</td>

                    <td>
                        @item.TotalAmount.ToString("N0") đ
                    </td>

                    <td>@item.PaymentStatus</td>

                    <td>@item.OrderStatus</td>

                    <td>
                        @Html.ActionLink(
                                 "Xem đơn hàng",
                                 "OrderSuccess",
                                 "Order",
                                 new { id = item.OrderID },
                                 new { @class = "btn btn-info btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
