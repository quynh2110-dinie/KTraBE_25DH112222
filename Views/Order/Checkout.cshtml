
@model List<WebApplication2.Models.CartItem>
@using System.Linq

@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    var customer = ViewBag.Customer
        as WebApplication2.Models.Customer;

    decimal total = Model.Sum(x => x.SubTotal);
}

<h2>THANH TOÁN ĐƠN HÀNG</h2>
<hr />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="row">
    <div class="col-md-7">

        @using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <h3>Thông tin nhận hàng</h3>

            <div class="form-group">
                <label>Họ tên</label>
                <input type="text"
                       class="form-control"
                       value="@(customer != null ? customer.CustomerName : "")"
                       readonly />
            </div>

            <div class="form-group">
                <label>Số điện thoại</label>
                <input type="text"
                       class="form-control"
                       value="@(customer != null ? customer.CustomerPhone : "")"
                       readonly />
            </div>

            <div class="form-group">
                <label>Địa chỉ giao hàng</label>
                <textarea name="addressDelivery"
                          class="form-control"
                          rows="3"
                          required>@(customer != null ? customer.CustomerAddress : "")</textarea>
            </div>

            <h3>Hình thức giao hàng</h3>

            <div class="radio">
                <label>
                    <input type="radio"
                           name="deliveryMethod"
                           value="Standard"
                           checked />
                    Giao hàng tiêu chuẩn
                </label>
            </div>

            <div class="radio">
                <label>
                    <input type="radio"
                           name="deliveryMethod"
                           value="Express" />
                    Giao hàng nhanh
                </label>
            </div>

            <h3>Hình thức thanh toán</h3>

            <div class="radio">
                <label>
                    <input type="radio"
                           name="paymentMethod"
                           value="COD"
                           checked />
                    Thanh toán khi nhận hàng (COD)
                </label>
            </div>

            <hr />

            <button type="submit"
                    class="btn btn-success btn-lg">
                Xác nhận đặt hàng
            </button>

            @Html.ActionLink(
                     "Quay lại giỏ hàng",
                     "Index",
                     "Cart",
                     null,
                     new { @class = "btn btn-default btn-lg" })
        }
    </div>

    <div class="col-md-5">
        <div class="panel panel-default">
            <div class="panel-heading">
                <strong>Đơn hàng của bạn</strong>
            </div>

            <div class="panel-body">
                <table class="table">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.ProductName
                                <span class="text-muted">
                                    x @item.Quantity
                                </span>
                            </td>
                            <td class="text-right">
                                @item.SubTotal.ToString("N0") đ
                            </td>
                        </tr>
                    }
                </table>

                <h3 class="text-right">
                    Tổng cộng:
                    <span style="color:#d9534f;">
                        @total.ToString("N0") đ
                    </span>
                </h3>

                <p class="text-muted">
                    Tổng tiền hiện chưa bao gồm phí vận chuyển.
                </p>
            </div>
        </div>
    </div>
</div>
