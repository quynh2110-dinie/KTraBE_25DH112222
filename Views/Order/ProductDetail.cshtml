
@model WebApplication2.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    .detail-image {
        width: 100%;
        max-height: 400px;
        object-fit: contain;
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 15px;
    }

    .detail-price {
        color: #d9534f;
        font-size: 28px;
        font-weight: bold;
        margin: 20px 0;
    }

    .detail-info {
        font-size: 16px;
        line-height: 2;
    }
</style>

<h2>CHI TIẾT SẢN PHẨM</h2>
<hr />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="row">
    <div class="col-md-5">
        @if (!string.IsNullOrEmpty(Model.ProductImage))
        {
            <img src="@Url.Content(
                Model.ProductImage.StartsWith("~/")
                ? Model.ProductImage
                : "~/Content/Images/" +
                  Model.ProductImage.TrimStart('/'))"
                 class="detail-image"
                 alt="@Model.ProductName" />
        }
        else
        {
            <div class="alert alert-info">
                Sản phẩm chưa có hình ảnh.
            </div>
        }
    </div>

    <div class="col-md-7">
        <h2>@Model.ProductName</h2>

        <p class="detail-price">
            @Model.ProductPrice.ToString("N0") đ
        </p>

        <div class="detail-info">
            <p>
                <strong>Danh mục:</strong>
                @(Model.Category != null
                    ? Model.Category.CategoryName
                    : "Chưa phân loại")
            </p>

            <p>
                <strong>Số lượng còn:</strong>
                @Model.Quantity
            </p>

            <p>
                <strong>Đã bán:</strong>
                @Model.SoldQuantity
            </p>

            <p><strong>Mô tả:</strong></p>

            <div class="well">
                @Model.ProductDecription
            </div>
        </div>

        @if (Model.Quantity > 0)
        {
            using (Html.BeginForm(
                "AddToCart", "Cart", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.ProductID" />

                <div class="form-group">
                    <label>Số lượng mua:</label>

                    <input type="number"
                           name="quantity"
                           value="1"
                           min="1"
                           max="@Model.Quantity"
                           class="form-control"
                           style="width:120px;" />
                </div>

                <button type="submit"
                        class="btn btn-success btn-lg">
                    Thêm vào giỏ hàng
                </button>
            }
        }
        else
        {
            <div class="alert alert-warning">
                Sản phẩm hiện đã hết hàng.
            </div>
        }

        <hr />

        @Html.ActionLink(
                 "Quay lại danh sách",
                 "ProductList",
                 "Home",
                 null,
                 new { @class = "btn btn-default" })
    </div>
</div>
