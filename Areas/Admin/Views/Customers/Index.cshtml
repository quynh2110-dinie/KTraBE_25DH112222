
@model PagedList.IPagedList<WebApplication2.Models.Customer>
@using PagedList.Mvc

@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>QUẢN LÝ KHÁCH HÀNG</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<p>
    @Html.ActionLink("Thêm khách hàng", "Create", null,
            new { @class = "btn btn-success" })
</p>

@using (Html.BeginForm("Index", "Customers",
    FormMethod.Get, new { @class = "form-inline" }))
{
    <div class="form-group">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               placeholder="Tên, SĐT, email, tài khoản..."
               class="form-control"
               style="width:260px" />
    </div>

    <div class="form-group">
        <select name="sortOrder" class="form-control">
            <option value="">Tên A-Z</option>
            <option value="name_desc"
                    @(ViewBag.SortOrder == "name_desc" ? "selected" : "")>
                Tên Z-A
            </option>
            <option value="newest"
                    @(ViewBag.SortOrder == "newest" ? "selected" : "")>
                Khách hàng mới nhất
            </option>
            <option value="oldest"
                    @(ViewBag.SortOrder == "oldest" ? "selected" : "")>
                Khách hàng cũ nhất
            </option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Tìm kiếm
    </button>

    @Html.ActionLink("Làm mới", "Index", null,
            new { @class = "btn btn-default" })
}

<br />

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead>
            <tr class="bg-primary">
                <th>Mã KH</th>
                <th>Họ tên</th>
                <th>Số điện thoại</th>
                <th>Email</th>
                <th>Địa chỉ</th>
                <th>Tài khoản</th>
                <th>Chức năng</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CustomerID</td>
                    <td>@item.CustomerName</td>
                    <td>@item.CustomerPhone</td>
                    <td>@item.CustomerEmail</td>
                    <td>@item.CustomerAddress</td>
                    <td>@item.Username</td>

                    <td style="white-space:nowrap">
                        @Html.ActionLink("Sửa", "Edit",
                                 new { id = item.CustomerID },
                                 new { @class = "btn btn-warning btn-sm" })

                        @Html.ActionLink("Chi tiết", "Details",
                                 new { id = item.CustomerID },
                                 new { @class = "btn btn-info btn-sm" })

                        @Html.ActionLink("Xóa", "Delete",
                                 new { id = item.CustomerID },
                                 new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        KHÔNG TÌM THẤY KHÁCH HÀNG.
    </div>
}

<p>
    Tổng số khách hàng: @Model.TotalItemCount
</p>

<p>
    Trang @(Model.PageCount < Model.PageNumber
        ? 0 : Model.PageNumber) / @Model.PageCount
    </p>

    @Html.PagedListPager(Model, page => Url.Action("Index",
        new
        {
            page,
            search = ViewBag.Search,
            sortOrder = ViewBag.SortOrder
        }))
