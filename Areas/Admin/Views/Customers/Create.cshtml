
@model WebApplication2.Models.Customer

@{
    ViewBag.Title = "Thêm khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>THÊM KHÁCH HÀNG</h2>

@using (Html.BeginForm("Create", "Customers",
    FormMethod.Post, new { area = "Admin" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />

        @Html.ValidationSummary(true, "",
                 new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(m => m.CustomerName, "Họ tên",
                     new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.TextBoxFor(m => m.CustomerName,
                         new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerName,
                         "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CustomerPhone, "Số điện thoại",
                     new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.TextBoxFor(m => m.CustomerPhone,
                         new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerPhone,
                         "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CustomerEmail, "Email",
                     new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.TextBoxFor(m => m.CustomerEmail,
                         new { @class = "form-control", type = "email" })
                @Html.ValidationMessageFor(m => m.CustomerEmail,
                         "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CustomerAddress, "Địa chỉ",
                     new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.TextAreaFor(m => m.CustomerAddress,
                         new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(m => m.CustomerAddress,
                         "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Username, "Tài khoản",
                     new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.DropDownList("Username", null,
                         "-- Chọn tài khoản --",
                         new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Username,
                         "", new { @class = "text-danger" })
                <small>Chỉ chọn tài khoản đã tồn tại trong bảng User.</small>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-6">
                <button type="submit" class="btn btn-success">
                    Thêm khách hàng
                </button>
                @Html.ActionLink("Quay lại", "Index", null,
                         new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
