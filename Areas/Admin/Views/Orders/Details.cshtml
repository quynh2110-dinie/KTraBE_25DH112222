
@model WebApplication2.Models.Order
@using System.Linq

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="panel panel-default">
    <div class="panel-heading">
        <strong>THÔNG TIN ĐƠN HÀNG</strong>
    </div>

    <div class="panel-body">
        <table class="table table-bordered">
            <tr>
                <th>Mã đơn hàng</th>
                <td>@Model.OrderID</td>
            </tr>
            <tr>
                <th>Khách hàng</th>
                <td>@Model.Customer.CustomerName</td>
            </tr>
            <tr>
                <th>Ngày đặt</th>
                <td>
                    @String.Format("{0:dd/MM/yyyy HH:mm}",
                             Model.OrderDate)
                </td>
            </tr>
            <tr>
                <th>Tổng tiền</th>
                <td>
                    <strong>
                        @String.Format("{0:N0} đ",
                                 Model.TotalAmount)
                    </strong>
                </td>
            </tr>
            <tr>
                <th>Phương thức thanh toán</th>
                <td>@Model.PaymentMethod</td>
            </tr>
            <tr>
                <th>Phương thức giao hàng</th>
                <td>@Model.DeliveryMethod</td>
            </tr>
            <tr>
                <th>Địa chỉ giao hàng</th>
                <td>@Model.AddressDelivery</td>
            </tr>
        </table>
    </div>
</div>

<div class="panel panel-info">
    <div class="panel-heading">
        <strong>DANH SÁCH SẢN PHẨM ĐÃ ĐẶT</strong>
    </div>

    <div class="panel-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Mã SP</th>
                    <th>Tên sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.OrderDetail)
                {
                    <tr>
                        <td>@item.ProductID</td>
                        <td>
                            @(item.Product != null
                                ? item.Product.ProductName
                                : "Sản phẩm không tồn tại")
                        </td>
                        <td>@item.Quantity</td>
                        <td>
                            @String.Format("{0:N0} đ",
                                     item.UnitPrice)
                        </td>
                        <td>
                            @String.Format("{0:N0} đ",
                                     item.SubTotal ??
                                     item.Quantity * item.UnitPrice)
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 class="text-right">
            Tổng cộng:
            <strong>
                @String.Format("{0:N0} đ", Model.TotalAmount)
            </strong>
        </h4>
    </div>
</div>

<div class="panel panel-primary">
    <div class="panel-heading">
        <strong>CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG</strong>
    </div>

    <div class="panel-body">
        @using (Html.BeginForm("UpdateStatus", "Orders",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.OrderID" />

            <div class="form-group">
                <label>Trạng thái đơn hàng</label>
                <select name="orderStatus"
                        class="form-control">
                    @foreach (var status in new[] {
                        "Pending",
                        "Confirmed",
                        "Shipping",
                        "Completed",
                        "Cancelled"
                    })
                    {
                        <option value="@status"
                                @(Model.OrderStatus == status ? "selected" : "")>
                            @status
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Trạng thái thanh toán</label>
                <select name="paymentStatus"
                        class="form-control">
                    @foreach (var status in new[] {
                        "Pending",
                        "Paid",
                        "Failed",
                        "Refunded"
                    })
                    {
                        <option value="@status"
                                @(Model.PaymentStatus == status ? "selected" : "")>
                            @status
                        </option>
                    }
                </select>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Lưu trạng thái
            </button>
        }
    </div>
</div>

@Html.ActionLink("Quay lại danh sách", "Index", null,
    new { @class = "btn btn-default" })
